{
  "name": "flashsoft-sk",
  "version": "1.4.9",
  "scripts": {
    "dev": "bun run vite dev",
    "build": "bun run vite build",
    "dev-netlify": "netlify dev",
    "preview": "vite preview",
    "test": "playwright test",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:unit": "vitest",
    "lint": "bun x biome lint --write",
    "format": "bun x biome format --write",
    "rewrite-history": "git filter-repo --paths-from-file files-to-remove.txt --invert-paths --force"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@fontsource/fira-mono": "^5.2.5",
    "@neoconfetti/svelte": "^2.2.2",
    "@playwright/test": "^1.52.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-netlify": "^7.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.2.12",
    "@vite-pwa/sveltekit": "^1.0.0",
    "puppeteer-core": "^24.7.2",
    "sass": "^1.106.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "svelte-lightbox": "^1.1.7",
    "svelte-preprocess": "^6.0.3",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.1.2",
    "workbox-build": "^7.3.0",
    "workbox-window": "^7.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "cheerio": "^1.2.0"
  },
  "removedDependencies": {
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-svelte3": "^4.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.3",
    "autoprefixer": "^10.4.20"
  },
  "type": "module",
  "license": "MIT",
  "imports": {
    "#lib": "./src/lib/index.js",
