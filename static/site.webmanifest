{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Flashsoft.eu",
  "start_url": "/",
  "short_name": "flashsoft.eu",
  "description": "PWA for domain flashsoft.eu.",
  "categories": [
    "programming",
    "personal",
    "tech",
    "dev"
  ],
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/images/icon/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/images/icon/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "display": "standalone"
}